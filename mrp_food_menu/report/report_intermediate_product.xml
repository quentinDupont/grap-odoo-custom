<odoo>

    <template id="report_intermediate_product">
        <t t-call="web.basic_layout">
            <div class="page_intermediate_to_prepare small-font-size">
              <div class="page_header">
                  <h2 class="text-left title-h2">Intermediate products to produce</h2>
                  <span t-esc="notes_for_pdf"/>
              </div>
              <br/>
              <table class="table table-sm table-bordered">
                  <thead>
                      <tr class="intermediate_product_thead th-colored">
                          <th name="th_intermediate_product_product" class="text-left">Bill of Material</th>
                          <th name="th_intermediate_product_qty" class="text-center width-qty-and-unit">Quantity</th>
                          <th name="th_intermediate_product_uom" class="text-left width-qty-and-unit">UoM</th>
                          <th name="th_intermediate_product_for" class="text-center width-fixed-small">For</th>
                          <th name="th_intermediate_product_free_comment" class="text-center width-fixed-large">Free comment</th>
                      </tr>
                  </thead>
                  <tbody class="intermediate_product_tbody">
                      <t t-foreach="docs" t-as="intermediate_product">
                          <tr>
                            <td name="td_intermediate_product_product" class="text-left">
                              <span t-esc="intermediate_product.product_id.name"/>
                            </td>
                            <td name="td_intermediate_product_qty" class="text-center width-qty-and-unit">
                              <span t-esc="intermediate_product.product_uom_qty"/>
                            </td>
                            <td name="td_intermediate_product_uom" class="text-left width-qty-and-unit">
                              <span t-esc="intermediate_product.product_uom_id.name"/>
                            </td>
                            <td name="td_intermediate_product_for" class="text-center">
                              <span t-esc="intermediate_product.finished_product_and_qty"/>
                            </td>
                            <td name="td_intermediate_product_free_comment" class="width-fixed-large"></td>
                          </tr>
                      </t>
                  </tbody>
              </table>
            </div>
        </t>
    </template>

</odoo>
