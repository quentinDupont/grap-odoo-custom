<odoo>

    <record id="view_food_menu_concatenated_intermediate_boms" model="ir.ui.view">
        <field name="model">mrp.food.menu.concatenated.intermediate.boms</field>
        <field name="arch" type="xml">
            <tree create="0" import="0">
                <field name="company_id" invisible="1" />
                <field name="menu_id" optional="hide"/>
                <field name="id" optional="hide"/>
                <field name="date"/>
                <field name="bom_id"/>
                <field name="product_id"/>
                <field name="product_uom_qty"/>
                <field name="product_uom_id" groups="uom.group_uom" />
                <field name="currency_id" invisible="1" />
                <field name="product_category_id" optional="hide"/>
                <field name="finished_product_and_qty" optional="show"/>
            </tree>
        </field>
    </record>

</odoo>
