<odoo>

    <!-- TREE VIEW  -->
    <record id="view_food_menu_concatenated_component_products" model="ir.ui.view">
        <field name="model">mrp.food.menu.concatenated.component.product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="company_id" invisible="1" />
                <field name="menu_id" optional="hide"/>
                <field name="id" optional="hide"/>
                <field name="date"/>
                <field name="product_category_id" optional="show"/>
                <field name="product_id"/>
                <field name="product_uom_qty" optional="hide"/>
                <field name="product_uom_id" groups="uom.group_uom" optional="hide"/>
                <field name="product_uom_po_qty"/>
                <field name="product_uom_po_id" groups="uom.group_uom"/>
                <field name="standard_price" optional="show" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" />
                <field name="bom_ids" optional="show" widget="many2many_tags" />
                <field name="currency_id" invisible="1" />
            </tree>
        </field>
    </record>

    <!-- FORM VIEW  -->
    <record id="view_food_menu_concatenated_component_products_form" model="ir.ui.view">
        <field name="model">mrp.food.menu.concatenated.component.product</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group col="12">
                        <field name="company_id" invisible="1" />
                        <field name="menu_id" optional="hide"/>
                        <field name="date"/>
                        <field name="product_category_id" optional="show"/>
                        <field name="product_id"/>
                        <field name="product_uom_qty"/>
                        <field name="product_uom_id" groups="uom.group_uom" />
                        <field name="standard_price" optional="show" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}" />
                        <field name="bom_ids" optional="show" widget="many2many_tags" />
                        <field name="currency_id" invisible="1" />
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH -->
    <record id="view_food_menu_concatenated_component_products_search" model="ir.ui.view">
        <field name="model">mrp.food.menu.concatenated.component.product</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="product_category_id"/>
                <field name="menu_id"/>
                <field name="bom_ids"/>
            </search>
        </field>
    </record>

</odoo>
